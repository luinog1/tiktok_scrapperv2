# HTTP / BFF
PORT=3000
SERVICE_API_KEY=
CORS_ORIGINS=http://localhost:3001
MAX_CONCURRENT_RUNS=2
ALLOW_PROVIDER_OVERRIDE=false
# Optional explicit degradation (off by default): scrapedo -> self, etc.
FALLBACK_SCRAPE_PROVIDER=

# Scrape engine: self (default), scrapedo (optional), apify (legacy rollback)
SCRAPE_PROVIDER=self

# Self-hosted mode. `auto` tries the local service endpoints and falls back to
# direct TikTok HTML fetch when a custom service does not expose search routes.
SCRAPE_SERVICE_URL=http://tiktok-dl:5555
SCRAPE_API_TOKEN=
SCRAPE_SEARCH_ENDPOINT=/tiktok/search/video
SCRAPE_HASHTAG_ENDPOINT=/tiktok/search/hashtag
SCRAPE_HEALTH_ENDPOINT=/health
SCRAPE_TIMEOUT_MS=120000
SELF_SCRAPE_MODE=auto
TIKTOK_BASE_URL=https://www.tiktok.com
TIKTOK_COOKIE=

# scrape.do (only required when SCRAPE_PROVIDER=scrapedo)
SCRAPE_DO_TOKEN=
SCRAPE_DO_BASE_URL=https://api.scrape.do
SCRAPE_DO_SUPER=true
SCRAPE_DO_RENDER=true
SCRAPE_DO_GEO_CODE=br
SCRAPE_DO_DEVICE=mobile
SCRAPE_DO_TIMEOUT_MS=60000
SCRAPE_DO_MAX_PAGES=5
SCRAPE_DO_CUSTOM_WAIT_MS=8000
SCRAPE_DO_WAIT_SELECTOR=
SCRAPE_DO_WAIT_UNTIL=

# Apify rollback (only required when SCRAPE_PROVIDER=apify)
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com
APIFY_ACTOR_ID=clockworks/tiktok-scraper
APIFY_TIMEOUT_MS=600000
APIFY_POLL_MS=2000

# Pipeline defaults
DEFAULT_MAX_RESULTS=50
DEFAULT_SORT_BY=playCount
TIER_VIRAL_VIEWS=5000000
TIER_VIRAL_ENGAGEMENT=5
TIER_HOT_VIEWS=1000000
TIER_HOT_ENGAGEMENT=3
TIER_RISING_VIEWS=100000
TIER_RISING_ENGAGEMENT=1.5

# Media
# douk = serviço DouK separado (GPL-3.0; nunca exponha token/porta do browser)
# cdn  = resolve o MP4 direto (estilo ssstik: resolver tikwm + fallback da página), sem serviço extra
# off  = download desligado (a API devolve fallbackUrl)
MEDIA_PROVIDER=douk
MEDIA_SERVICE_URL=http://tiktok-dl:5555
MEDIA_API_TOKEN=
MEDIA_DOWNLOAD_ENDPOINT=/tiktok/detail
MEDIA_TIMEOUT_MS=120000
MEDIA_MAX_BYTES=104857600
# Resolver tikwm-compatível do modo cdn; "off" desativa e usa somente a página do vídeo
MEDIA_CDN_RESOLVER_URL=https://www.tikwm.com
SCRAPE_DO_BLOCK_RESOURCES=false
SCRAPE_DO_RETURN_JSON=true
SCRAPE_DO_STICKY_SESSION=true
